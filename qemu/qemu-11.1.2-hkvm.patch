diff --git a/hw/misc/host-battery.c b/hw/misc/host-battery.c
new file mode 100644
index 0000000..882231d
--- /dev/null
+++ b/hw/misc/host-battery.c
@@ -0,0 +1,180 @@
+/*
+ * host-battery: expose the host's /sys/class/power_supply battery + AC
+ * adapter to the guest as a block of read-only 32-bit I/O registers.
+ * A guest SSDT (hackintosh-kvm src/acpi/SSDT-HOSTBAT.dsl) reads them from
+ * _BIF/_BST/_PSR, so the guest sees the real laptop battery.
+ *
+ * Registers (dword, offset):
+ *   0x00 magic 'HBAT'     0x04 _BST state (1 discharging, 2 charging)
+ *   0x08 rate (mA|mW)     0x0c remaining (mAh|mWh)
+ *   0x10 voltage (mV)     0x14 design capacity
+ *   0x18 last full        0x1c design voltage (mV)
+ *   0x20 AC online        0x24 cycle count
+ *   0x28 power unit (0 mWh, 1 mAh)   0x2c present
+ *   0x30 capacity percent
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation; either version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/isa/isa.h"
+#include "hw/core/qdev-properties.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "qom/object.h"
+
+#define TYPE_HOST_BATTERY "host-battery"
+OBJECT_DECLARE_SIMPLE_TYPE(HostBatteryState, HOST_BATTERY)
+
+#define HBAT_NREGS 13
+
+struct HostBatteryState {
+    ISADevice parent_obj;
+
+    uint32_t iobase;
+    char *bat;
+    char *ac;
+    MemoryRegion io;
+    uint32_t regs[HBAT_NREGS];
+    int64_t last_ms;
+};
+
+static bool read_sysfs(const char *dev, const char *attr, long long *val)
+{
+    g_autofree char *path = g_strdup_printf("/sys/class/power_supply/%s/%s",
+                                            dev, attr);
+    g_autofree char *buf = NULL;
+
+    if (!g_file_get_contents(path, &buf, NULL, NULL)) {
+        return false;
+    }
+    *val = strtoll(buf, NULL, 10);
+    return true;
+}
+
+static uint32_t sysfs_u32(const char *dev, const char *attr, long long div)
+{
+    long long v;
+
+    if (!read_sysfs(dev, attr, &v) || v < 0) {
+        return 0xffffffff;      /* ACPI "unknown" */
+    }
+    return v / div;
+}
+
+static void host_battery_refresh(HostBatteryState *s)
+{
+    int64_t now = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+    g_autofree char *status = NULL;
+    g_autofree char *path = NULL;
+    long long v;
+    bool energy;
+    uint32_t state = 0;
+
+    if (s->last_ms && now - s->last_ms < 1000) {
+        return;
+    }
+    s->last_ms = now;
+
+    energy = !read_sysfs(s->bat, "charge_full", &v);
+    s->regs[0] = 0x54414248;    /* 'HBAT' */
+    path = g_strdup_printf("/sys/class/power_supply/%s/status", s->bat);
+    if (g_file_get_contents(path, &status, NULL, NULL)) {
+        if (g_str_has_prefix(status, "Discharging")) {
+            state = 1;
+        } else if (g_str_has_prefix(status, "Charging")) {
+            state = 2;
+        }
+    }
+    s->regs[1] = state;
+    if (energy) {
+        s->regs[2] = sysfs_u32(s->bat, "power_now", 1000);
+        s->regs[3] = sysfs_u32(s->bat, "energy_now", 1000);
+        s->regs[5] = sysfs_u32(s->bat, "energy_full_design", 1000);
+        s->regs[6] = sysfs_u32(s->bat, "energy_full", 1000);
+    } else {
+        s->regs[2] = sysfs_u32(s->bat, "current_now", 1000);
+        s->regs[3] = sysfs_u32(s->bat, "charge_now", 1000);
+        s->regs[5] = sysfs_u32(s->bat, "charge_full_design", 1000);
+        s->regs[6] = sysfs_u32(s->bat, "charge_full", 1000);
+    }
+    s->regs[4] = sysfs_u32(s->bat, "voltage_now", 1000);
+    s->regs[7] = sysfs_u32(s->bat, "voltage_min_design", 1000);
+    s->regs[8] = read_sysfs(s->ac, "online", &v) ? !!v : 1;
+    s->regs[9] = sysfs_u32(s->bat, "cycle_count", 1);
+    s->regs[10] = energy ? 0 : 1;
+    s->regs[11] = read_sysfs(s->bat, "present", &v) ? !!v : 0;
+    s->regs[12] = sysfs_u32(s->bat, "capacity", 1);
+}
+
+static uint64_t host_battery_read(void *opaque, hwaddr addr, unsigned size)
+{
+    HostBatteryState *s = opaque;
+
+    if (addr / 4 >= HBAT_NREGS) {
+        return 0;
+    }
+    host_battery_refresh(s);
+    return s->regs[addr / 4] >> ((addr & 3) * 8);
+}
+
+static void host_battery_write(void *opaque, hwaddr addr, uint64_t val,
+                               unsigned width)
+{
+}
+
+static const MemoryRegionOps host_battery_ops = {
+    .read = host_battery_read,
+    .write = host_battery_write,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static void host_battery_realizefn(DeviceState *d, Error **errp)
+{
+    ISADevice *dev = ISA_DEVICE(d);
+    HostBatteryState *s = HOST_BATTERY(d);
+
+    if (!s->bat) {
+        s->bat = g_strdup("BAT0");
+    }
+    if (!s->ac) {
+        s->ac = g_strdup("ADP1");
+    }
+    memory_region_init_io(&s->io, OBJECT(dev), &host_battery_ops, s,
+                          TYPE_HOST_BATTERY, 0x40);
+    memory_region_add_subregion(isa_address_space_io(dev), s->iobase, &s->io);
+}
+
+static const Property host_battery_properties[] = {
+    DEFINE_PROP_UINT32("iobase", HostBatteryState, iobase, 0x530),
+    DEFINE_PROP_STRING("bat", HostBatteryState, bat),
+    DEFINE_PROP_STRING("ac", HostBatteryState, ac),
+};
+
+static void host_battery_class_initfn(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = host_battery_realizefn;
+    device_class_set_props(dc, host_battery_properties);
+    set_bit(DEVICE_CATEGORY_MISC, dc->categories);
+}
+
+static const TypeInfo host_battery_info = {
+    .name          = TYPE_HOST_BATTERY,
+    .parent        = TYPE_ISA_DEVICE,
+    .instance_size = sizeof(HostBatteryState),
+    .class_init    = host_battery_class_initfn,
+};
+
+static void host_battery_register_types(void)
+{
+    type_register_static(&host_battery_info);
+}
+
+type_init(host_battery_register_types)
