+    /*
+     * RMB_KEEP_CMD=<host bdf>: never let the guest clear MEM/BUS_MASTER on the
+     * physical device (macOS does early in boot; the 680M boot scanout then stalls).
+     * The emulated config space still sees the guest's value.
+     */
+    /*
+     * RMB_KEEP_CMD device: log every guest config write with wall-clock ms, to line up
+     * with the boot-logo timeline (logs/dcn-timeline-*.txt).
+     */
+    {
+        const char *keep = getenv("RMB_KEEP_CMD");
+        if (keep && !strcmp(keep, vbasedev->name)) {
+            struct timespec ts;
+            clock_gettime(CLOCK_REALTIME, &ts);
+            fprintf(stderr, "rmb: %ld.%03ld %s cfg write addr 0x%x len %d val 0x%x\n",
+                    (long)ts.tv_sec, ts.tv_nsec / 1000000, vbasedev->name, addr, len, val);
+        }
+    }
+    if (range_covers_byte(addr, len, PCI_COMMAND)) {
+        const char *keep = getenv("RMB_KEEP_CMD");
+        uint32_t shift = (PCI_COMMAND - addr) * 8;
+        uint32_t bits = (uint32_t)(PCI_COMMAND_MEMORY | PCI_COMMAND_MASTER) << shift;
+
+        fprintf(stderr, "rmb: %s guest COMMAND write 0x%x (addr 0x%x len %d)\n",
+                vbasedev->name, (val >> shift) & 0xffff, addr, len);
+        if (keep && !strcmp(keep, vbasedev->name) && (val & bits) != bits) {
+            fprintf(stderr, "rmb: %s keeping MEM|BUS_MASTER set on hardware\n",
+                    vbasedev->name);
+            val_le = cpu_to_le32(val | bits);
+        }
+    }
+
     /* Write everything to VFIO, let it filter out what we can't write */
     ret = vfio_pci_config_space_write(vdev, addr, len, &val_le);
     if (ret != len) {
